{
  "name": "guild-wars-mvp",
  "description": "Next.js, Tailwind, @solana/kit wallet + on-chain actions",
  "keywords": [
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:e2e": "playwright test",
    "test:load": "vitest run --config vitest.performance.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "worker:dev": "node --env-file-if-exists=.env.local --import tsx --watch worker/main.ts",
    "worker:check": "node scripts/worker-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run worker:check",
    "db:worker:migrate:test": "tsx scripts/migrate-worker.ts",
    "test:e2e:container": "node --import tsx scripts/test-browser.mjs",
    "ops:health": "node --env-file-if-exists=.env.local --import tsx scripts/health.ts",
    "ops:restore-check": "node --env-file-if-exists=.env.local --import tsx scripts/restore-check.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@solana/kit": "8.5.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-wallet": "0.20.0",
    "@solana/react": "8.5.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/ui-features": "1.0.3",
    "@wallet-standard/ui-registry": "1.1.1",
    "drizzle-orm": "0.45.4",
    "grammy": "1.46.0",
    "graphile-worker": "0.18.0",
    "lightweight-charts": "5.2.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wallet-standard/wallet": "1.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "type": "module"
}
